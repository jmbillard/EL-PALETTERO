<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.jmbillard.elpalletero" ExtensionBundleVersion="1.5.1" ExtensionBundleName="El PALLETERO"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<ExtensionList>
		<Extension Id="com.jmbillard.elpalletero.panel" Version="1.5.1" />
	</ExtensionList>
	<ExecutionEnvironment>
		<HostList>
			<Host Name="AEFT" Version="[22.0,99.9]" />
		</HostList>
		<LocaleList>
			<Locale Code="All" />
		</LocaleList>
		<RequiredRuntimeList>
			<RequiredRuntime Name="CSXS" Version="11.0" />
		</RequiredRuntimeList>
	</ExecutionEnvironment>
	<DispatchInfoList>
		<Extension Id="com.jmbillard.elpalletero.panel">
			<DispatchInfo>
				<Resources>
					<MainPath>./index.html</MainPath>
					<ScriptPath>./jsx/host.jsx</ScriptPath>
					<CEFCommandLine>
						<Parameter>--enable-nodejs</Parameter>
						<Parameter>--mixed-context</Parameter>
					</CEFCommandLine>
				</Resources>
				<Lifecycle>
					<AutoVisible>true</AutoVisible>
				</Lifecycle>
				<UI>
					<Type>Panel</Type>
					<Menu>El PALLETERO</Menu>
					<Geometry>
						<Size>
							<Height>72</Height>
							<Width>720</Width>
						</Size>
						<MinSize>
							<Height>40</Height>
							<Width>120</Width>
						</MinSize>
					</Geometry>
					<Icons>
						<Icon Type="Normal">./icons/icon.png</Icon>
						<Icon Type="RollOver">./icons/icon.png</Icon>
						<Icon Type="DarkNormal">./icons/icon.png</Icon>
						<Icon Type="DarkRollOver">./icons/icon.png</Icon>
					</Icons>
				</UI>
			</DispatchInfo>
		</Extension>
	</DispatchInfoList>
</ExtensionManifest>
